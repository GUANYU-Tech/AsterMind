      "tensor_parallel_degree": 1,
      "pipeline_parallel_degree": 1,
      "expert_parallel_degree": 4,
      "microbatch_count": 1,
      "max_satellites": 4,
      "expert_parallel_imbalance_factor": 1.0,
      "expert_parallel_startup_us": 0
