{
  "experiment_id": "smoke_moe_ep_parallel",
  "description": "MoE serving throughput smoke test with cross-satellite expert parallelism.",
  "constellation": {
    "name": "smoke_walker_550km_ep",
    "shells": [
      {
        "name": "walker_550_53_ep",
        "orbit_family": "walker",
        "altitude_km": 550,
        "inclination_deg": 53,
        "plane_count": 2,
        "sats_per_plane": 4,
        "min_elevation_deg": 25,
        "phase_factor": 1
      }
    ]
  },
  "costing": {
    "scale_by": "satellite_count"
  },
  "workload": {
    "bundle_dir": "tests/fixtures/workloads/smoke_flat_single_turn_direct"
