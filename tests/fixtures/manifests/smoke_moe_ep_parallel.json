    "decode": {
      "batching_window_ms": 20,
      "batch_size": 4
    },
    "kv_cache_capacity_gb": null,
    "effective_utilization": 0.5
  },
  "simulation": {
    "duration_s": 21600,
    "step_s": 60,
    "epoch": "2026-06-16T00:00:00Z",
    "use_stk_calibrated_surrogate": false
  },
  "scheduler": {
    "policy": "orbitserve",
    "lookahead_orbits": 1
  },
  "dse": {
    "enabled": false,
    "sweep": {}
  },
  "hardware": {
    "mode": "from_cost_case",
    "source_case_path": "examples/single_satellite/h200_gpu_derived.json"
  }
}
