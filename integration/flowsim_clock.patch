+using Tick = unsigned __int128;
+constexpr long double kTicksPerNs = 1000000000.0L;
+Tick parse_ticks(const std::string &value) {
+  if (value.empty()) throw std::invalid_argument("empty clock tick");
+  Tick result = 0;
+  for (char c : value) {
+    if (c < '0' || c > '9' || result > (~Tick(0) - (c - '0')) / 10)
+      throw std::invalid_argument("invalid or overflowing clock tick");
+    result = result * 10 + (c - '0');
+  }
+  return result;
+}
+std::string tick_string(Tick value) {
+  std::string result;
+  do { result.push_back('0' + value % 10); value /= 10; } while (value);
+  std::reverse(result.begin(), result.end());
+  return result;
+}
 
